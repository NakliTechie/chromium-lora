+// chromium-lora fork: asks the browser to prompt the user for the
+// AI_ADAPTER permission on this site.
+ScriptPromise<IDLBoolean> LanguageModel::requestAdapter(
+    ScriptState* script_state,
+    ExceptionState& exception_state) {
+  if (!script_state->ContextIsValid()) {
+    ThrowInvalidContextException(exception_state);
+    return EmptyPromise();
+  }
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLBoolean>>(script_state);
+  auto promise = resolver->Promise();
+  HeapMojoRemote<mojom::blink::AIManager>& ai_manager_remote =
+      AIInterfaceProxy::GetAIManagerRemote(
+          ExecutionContext::From(script_state));
+  ai_manager_remote->RequestAdapter(BindOnce(
+      [](ScriptPromiseResolver<IDLBoolean>* resolver, bool granted) {
+        resolver->Resolve(granted);
+      },
+      WrapPersistent(resolver)));
+  return promise;
+}
